{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DB_CONNECTION_STRING",
    "JWT_SECRET",
    "ENCRYPTION_KEY",
    "DATA_DIR",
    "API_SYNC_ENABLED",
    "API_SYNC_INTERVAL",
    "LOG_LEVEL",
    "NODE_ENV",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {},
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"]
    },
    "test:integration:postgres": {
      "dependsOn": ["^build"]
    },
    "test:integration:mysql": {
      "dependsOn": ["^build"]
    },
    "test:local": {
      "dependsOn": ["@txls/shared#build"]
    },
    "test:docker": {
      "dependsOn": ["@txls/shared#build"]
    },
    "test:hass": {
      "dependsOn": ["@txls/shared#build"]
    }
  }
}
