{
  "name": "@txls/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "test": "vitest run --config ../vitest.unit.config.ts",
    "test:unit": "vitest run --config ../vitest.unit.config.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "csv-parse": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mysql2": "^3.18.0",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.14.0",
    "typeorm": "^0.3.20",
    "umzug": "^3.8.2",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.11.24",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
