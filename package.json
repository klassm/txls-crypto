{
  "name": "txls-crypto",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc --project tsconfig.migrations.json --incremental false",
    "start": "next start",
    "lint": "biome lint src test test-e2e",
    "lint:fix": "biome lint --write src test test-e2e",
    "format": "biome format --write src test test-e2e",
    "check": "biome check src test test-e2e",
    "check:fix": "biome check --write src test test-e2e",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npx vitest run --config vitest.unit.config.ts",
    "test:integration": "npx vitest run --no-file-parallelism",
    "test:integration:all": "vitest run test/integration/databases.spec.ts",
    "test:integration:sqlite": "vitest run test/integration/databases.spec.ts -t 'SQLite'",
    "test:integration:postgres": "vitest run test/integration/databases.spec.ts -t 'PostgreSQL'",
    "test:integration:mysql": "vitest run test/integration/databases.spec.ts -t 'MySQL'",
    "test:watch": "vitest",
    "test:gui": "playwright test",
    "test:gui:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "better-sqlite3": "^12.6.2",
    "biome": "latest",
    "knip": "^5.85.0",
    "kysely": "^0.28.11",
    "supertest": "^7.2.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@tanstack/react-query": "^5.90.21",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "csv-parse": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "material-react-table": "^3.2.1",
    "mysql2": "^3.18.0",
    "next": "^16.1.6",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.14.0",
    "typeorm": "^0.3.20",
    "umzug": "^3.8.2",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  }
}
