{
  "name": "txls-crypto",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "shared",
    "server",
    "client",
    "gui-tests"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start -w server",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "vitest run --no-file-parallelism",
    "test:gui": "turbo run test --filter=@txls/gui-tests",
    "test:gui:local": "npm run test:local -w @txls/gui-tests",
    "test:gui:docker": "npm run test:docker -w @txls/gui-tests",
    "test:gui:hass": "npm run test:hass -w @txls/gui-tests"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "better-sqlite3": "^12.6.2",
    "biome": "latest",
    "supertest": "^7.2.2",
    "turbo": "^2.4.4",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
